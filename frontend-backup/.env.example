# 📁 Fichier .env.example pour le Frontend
# Copier ce fichier en .env et adapter les valeurs pour votre environnement

# URL de base de l'API Backend
# En développement : http://localhost:8000
# En production : https://votre-domaine-api.com
VITE_API_BASE_URL=http://localhost:8000

# Port du frontend (par défaut : 5173 pour Vite)
# VITE_PORT=5173

# Mode de développement/production
# NODE_ENV=development
