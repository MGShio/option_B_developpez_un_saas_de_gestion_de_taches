# ╔══════════════════════════════════════════════════════════════╗
# ║     BACKEND - Template Variables d'Environnement            ║
# ║  Copier ce fichier en .env et adapter les valeurs             ║
# ║  NE PAS MODIFIER CE FICHIER DIRECTEMENT                      ║
# ╚══════════════════════════════════════════════════════════════╝

# 🗃️ Base de données
# SQLite pour le développement, PostgreSQL en production
# Format SQLite: "file:./db.sqlite"
# Format PostgreSQL: "postgresql://user:password@localhost:5432/dbname?schema=public"
DATABASE_URL="file:./db.sqlite"

# 🔐 JWT Configuration
# Générer une clé secrète: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="MY_SECRET_KEY_HERE"
# Durée de validité des tokens (1h, 1d, 7d, etc.)
JWT_EXPIRES_IN="7d"

# 🌐 Serveur
# Port du serveur Express
PORT=8000
# Environnement (development/production)
NODE_ENV=development
