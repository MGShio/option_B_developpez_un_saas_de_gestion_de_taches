# ╔══════════════════════════════════════════════════════════════╗
# ║        FRONTEND - Next.js Variables d'Environnement       ║
# ║  Template pour les variables d'environnement               ║
# ╚══════════════════════════════════════════════════════════════╝

# 🔗 URL de base de l'API Backend
# En développement: http://localhost:8000
# En production: https://votre-domaine-api.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 🌐 Port du frontend (par défaut: 3000 pour Next.js)
PORT=3000

# 🏷️  Environnement (development/production)
NODE_ENV=development
